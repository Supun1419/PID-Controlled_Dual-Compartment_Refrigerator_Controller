PWM3.$name                            = "CONFIG_PWM_2";
PWM3.prescalerDivider                 = 255;
PWM3.timerObject.$name                = "CONFIG_LGPTIMER_2";
PWM3.timerObject.channel1Connection   = "Pin";
PWM3.timerObject.timer.$assign        = "LGPT1";
